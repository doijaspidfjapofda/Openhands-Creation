.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(27, 53, 43, 0.38);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.dialog {
  width: 100%;
  max-width: 420px;
  background: #fff;
  border-radius: 18px;
  box-shadow: 0 30px 100px rgba(20, 43, 52, 0.2);
  padding: 24px;
}

.d-title {
  display: block;
  font-size: 18px;
  font-weight: 650;
  margin-bottom: 10px;
  line-height: 1.4;
}

.d-desc {
  display: block;
  color: #7d8d7d;
  font-size: 13px;
  line-height: 1.9;
  white-space: pre-line;
}

.d-input {
  width: 100%;
  border: 1px solid #e4eae4;
  border-radius: 10px;
  padding: 12px;
  font-size: 14px;
  margin-top: 16px;
  background: #fcfdfa;
}

.d-error {
  display: block;
  color: #b75d4f;
  font-size: 12px;
  min-height: 18px;
  margin-top: 8px;
}

.d-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-end;
  margin-top: 20px;
}

.d-btn {
  height: 42px;
  padding: 0 16px;
  border-radius: 10px;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #235f4d;
  color: #fff;
  flex: 1;
  min-width: 100px;
}

.d-btn.secondary {
  background: #fff;
  color: #235f4d;
  border: 1px solid #cfded2;
}

.d-btn.danger {
  background: #b75d4f;
  color: #fff;
}

.d-btn.ghost {
  background: #f2f5ef;
  color: #718177;
}
