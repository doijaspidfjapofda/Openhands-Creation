.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid #e4eae4;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  justify-content: space-around;
  padding: 8px 12px 6px;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 6px 0 2px;
  color: #98a493;
  font-size: 11px;
}

.tab.on {
  color: #235f4d;
  font-weight: 650;
}

.dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: transparent;
}

.tab.on .dot {
  background: #235f4d;
}
