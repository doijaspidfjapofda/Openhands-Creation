<view class="tabbar">
  <view class="tabbar-inner">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="tab {{item.key === current ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <text class="tab-label">{{item.label}}</text>
      <view class="dot"></view>
    </view>
  </view>
</view>
