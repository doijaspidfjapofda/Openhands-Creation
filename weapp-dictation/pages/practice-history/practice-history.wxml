<app-header role="{{role}}" students="{{students}}" activeId="{{activeChildId}}" />

<view class="page">
  <view class="page-head">
    <text class="eyebrow">PRACTICE HISTORY</text>
    <text class="h1">一点点积累，都有记录</text>
    <text class="desc">提示下写对、独立写对，我们分别记录。</text>
  </view>

  <view class="card" wx:if="{{list.length}}">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="history-item"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="history-icon">✦</view>
      <view class="grow">
        <text class="history-title">错词拼写练习</text>
        <text class="history-sub">{{item.dateText}}{{item.sample ? ' · 演示记录' : ''}}</text>
      </view>
      <view class="history-count">
        <text>{{item.total}} 个词</text>
        <text class="history-sub">独立写对 {{item.independent}}</text>
      </view>
      <text class="chev">›</text>
    </view>
  </view>

  <view class="card" wx:else>
    <empty-state
      mark="✦"
      title="从第一次复习开始"
      desc="完成一组错词练习后，可以在这里看到记录。"
      action="去看看我的错词"
      bind:action="onBank"
    />
  </view>
</view>

<tab-bar role="{{role}}" current="practice-history" />
