.draft-banner {
  background: #fff6e8;
  border: 1px solid #efdfc4;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.draft-title {
  display: block;
  font-size: 12px;
  color: #927448;
  font-weight: 600;
}

.draft-sub {
  display: block;
  font-size: 10px;
  color: #a98d63;
  margin-top: 3px;
}

.draft-actions {
  display: flex;
  gap: 6px;
  flex: none;
}

.intro {
  border: 1px solid #dfe9dc;
  border-radius: 16px;
  background: linear-gradient(110deg, #edf4e8, #f2f6eb);
  padding: 20px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 18px;
  overflow: hidden;
}

.intro-title {
  display: block;
  font-size: 16px;
  font-weight: 650;
  margin-bottom: 6px;
}

.intro-sub {
  display: block;
  font-size: 11px;
  color: #74846c;
  line-height: 1.8;
}

.steps {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  font-size: 9px;
  color: #64805c;
  flex-wrap: wrap;
}

.step {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.step-no {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  color: #54714b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
}

.dash {
  color: #a0b297;
}

.book {
  flex: none;
  width: 72px;
  height: 84px;
  border-radius: 4px 10px 10px 4px;
  background: #567b58;
  box-shadow: 6px 5px 0 #d3dfbd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff4ce;
  transform: rotate(-8deg);
  margin-right: 6px;
}

.book-a {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 26px;
}

.book-t {
  font-size: 6px;
  letter-spacing: 1.4px;
  margin-top: 4px;
}

.book-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 14px;
  border-bottom: 1px solid #e4eae4;
}

.book-icon {
  width: 32px;
  height: 36px;
  border-radius: 5px;
  background: #edf2e8;
  color: #6b895d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  flex: none;
}

.meta-title {
  display: block;
  font-size: 12px;
  font-weight: 600;
}

.meta-sub {
  display: block;
  font-size: 10px;
  color: #78867f;
  margin-top: 2px;
}

.filters {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  flex-wrap: wrap;
}

.select {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid #e4eae4;
  border-radius: 9px;
  padding: 7px 11px;
  font-size: 12px;
  color: #4d6557;
  background: #fafbf9;
  white-space: nowrap;
}

.select-block {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 16px;
  padding: 10px 12px;
  font-size: 12px;
}

.unit-scroll {
  white-space: nowrap;
  margin: 12px 0 10px;
  width: 100%;
}

.units {
  display: inline-flex;
  gap: 7px;
}

.unit {
  padding: 7px 12px;
  border: 1px solid #e4eae4;
  border-radius: 8px;
  font-size: 12px;
  color: #7d8b81;
  background: #fff;
  white-space: nowrap;
}

.unit.on {
  border-color: #235f4d;
  background: #235f4d;
  color: #fff;
}

.search {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #e4eae4;
  border-radius: 9px;
  background: #fafbf9;
  padding: 0 12px;
  margin-bottom: 8px;
}

.search-icon {
  font-size: 15px;
  color: #9ba59e;
}

.search-input {
  flex: 1;
  height: 40px;
  font-size: 12px;
  color: #243b34;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0 10px;
  gap: 10px;
  font-size: 11px;
  color: #78867f;
}

.check-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #576e60;
}

.link {
  color: #235f4d;
}

.word-row {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 0;
  border-bottom: 1px solid #eef2ec;
}

.word-row:last-child {
  border-bottom: none;
}

.word-row.on {
  background: #f9fcf8;
}

.word-line {
  display: flex;
  align-items: baseline;
  gap: 7px;
  flex-wrap: wrap;
}

.ipa-inline {
  font-size: 10px;
  color: #9ba69e;
  font-family: Arial, sans-serif;
}

.count {
  display: flex;
  align-items: baseline;
  gap: 7px;
  margin: 14px 0 2px;
}

.count-num {
  font-size: 42px;
  font-weight: 550;
  letter-spacing: -2px;
  line-height: 1;
}

.count-unit {
  font-size: 12px;
  color: #78867f;
}

.radio-card {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid #e4eae4;
  border-radius: 10px;
  padding: 11px;
  margin-bottom: 8px;
  background: #fff;
}

.radio-card.on {
  background: #f2f7f0;
  border-color: #a4bea3;
}

.radio-dot {
  width: 15px;
  height: 15px;
  border: 1px solid #cbd6c7;
  border-radius: 50%;
  flex: none;
  background: #fff;
}

.radio-card.on .radio-dot {
  border: 4px solid #235f4d;
}

.radio-title {
  display: block;
  font-size: 12px;
  font-weight: 600;
}

.radio-sub {
  display: block;
  font-size: 10px;
  color: #78867f;
  margin-top: 2px;
}

.start-btn {
  margin-top: 4px;
}

.tip {
  padding: 14px 16px;
  border-radius: 12px;
  background: #f0f3eb;
  margin-top: 12px;
}

.tip-title {
  display: block;
  color: #60744e;
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 3px;
}

.tip-body {
  font-size: 11px;
  line-height: 1.8;
  color: #839076;
}

.foot-note {
  display: block;
  font-size: 10px;
  color: #a1aba0;
  text-align: center;
  margin-top: 22px;
}

@media (max-width: 400px) {
  .book {
    display: none;
  }

  .intro {
    padding: 16px;
  }
}
