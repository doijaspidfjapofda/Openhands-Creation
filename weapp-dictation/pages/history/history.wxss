.top-action {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 10px;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid #e4eae4;
}

.history-item:last-child {
  border-bottom: none;
}

.history-icon {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  background: #edf4e9;
  color: #729567;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex: none;
}

.history-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
}

.history-sub {
  display: block;
  font-size: 10px;
  color: #95a08f;
  margin-top: 4px;
}

.history-count {
  text-align: right;
  font-size: 12px;
  color: #6d8067;
  flex: none;
}

.chev {
  color: #b3bdb5;
  font-size: 18px;
  flex: none;
}
