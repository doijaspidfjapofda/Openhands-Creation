.hero {
  text-align: center;
  padding: 18px 12px 20px;
}

.hero-icon {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #eaf3e4;
  color: #699362;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  margin: 0 auto 12px;
}

.hero-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
}

.hero-sub {
  display: block;
  font-size: 11px;
  color: #8a958b;
  line-height: 1.9;
}

.res-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid #f0f3ed;
}

.res-row:last-child {
  border-bottom: none;
}

.res-answer {
  display: block;
  font-size: 11px;
  color: #8b978b;
  margin-top: 4px;
}

.actions {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
