<app-header
  role="{{role}}"
  students="{{students}}"
  activeId="{{activeChildId}}"
  lockSwitch="{{true}}"
/>

<view class="page">
  <view class="crumbs">
    <text class="back" bindtap="onBack">‹ 返回选词</text>
    <text>/</text>
    <text>{{modeText}} · {{childName}}</text>
    <text class="spacer"></text>
    <text class="tag gray">进度自动保存</text>
  </view>

  <view class="page-head">
    <text class="eyebrow">DICTATION IN PROGRESS</text>
    <text class="h1">{{isAuto ? '让系统念，孩子专心写' : '陪孩子写好这一个词'}}</text>
    <text class="desc">{{isAuto ? '自动播报期间不要求实时批改，播完后统一对照纸面答案。' : '可以逐词批改，也可以先听写完，再点击题号统一批改。'}}</text>
  </view>

  <view class="split">
    <view class="card main-card">
      <view class="progress">
        <view class="progress-fill" style="width:{{progressPct}}%"></view>
      </view>

      <block wx:if="{{isAuto && phase === 'ready'}}">
        <view class="auto-panel">
          <text class="auto-eyebrow">AUTO DICTATION</text>
          <text class="auto-title">准备好后，点“开始”</text>
          <text class="auto-desc">共 {{total}} 个词，按顺序自动朗读。单词、音标和中文释义默认隐藏。</text>

          <view class="interval">
            <view class="interval-head">
              <text class="field-label">相邻单词间隔</text>
              <text class="interval-value">{{intervalSec}} 秒</text>
            </view>
            <slider
              min="2"
              max="15"
              step="1"
              value="{{intervalSec}}"
              activeColor="#235f4d"
              backgroundColor="#e4eae4"
              block-size="20"
              bindchange="onInterval"
            />
            <text class="helper">当前语音播报结束后，再等待所设间隔，然后开始下一个词。</text>
          </view>

          <button class="btn btn-block" bindtap="onStartAuto">开始自动听写</button>

          <view class="peek">
            <view class="peek-word {{reveal ? '' : 'hide'}}">{{reveal ? word.en : '••••••'}}</view>
            <view class="peek-meta" wx:if="{{reveal}}">
              <text class="meaning">{{word.zh}}</text>
              <text class="ipa">{{word.ipa}}</text>
            </view>
            <text class="text-btn" bindtap="onToggleAnswer">{{reveal ? '收起答案' : '家长查看当前词'}}</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{isAuto && phase === 'playing'}}">
        <view class="auto-panel">
          <text class="auto-position">第 {{index + 1}} 个 / 共 {{total}} 个</text>

          <view class="pulse {{paused ? 'paused' : ''}}" bindtap="onPulse">
            <text class="pulse-icon">{{paused ? '▶' : '❚❚'}}</text>
          </view>

          <text class="audio-state">{{audioStatus}}</text>
          <text class="wait" wx:if="{{waitLeft > 0}}">下一个词 {{waitLeft}} 秒后开始</text>

          <view class="play-controls">
            <button class="btn btn-sm btn-secondary" bindtap="onPulse">{{paused ? '继续' : '暂停'}}</button>
            <button class="btn btn-sm btn-secondary" bindtap="onSkip">跳过</button>
            <button class="btn btn-sm btn-ghost" bindtap="onEndEarly">提前结束</button>
          </view>

          <text class="helper">暂停 / 跳过 / 提前结束为原型假设，待确认；继续时会重播当前词。</text>

          <view class="peek">
            <view class="peek-word {{reveal ? '' : 'hide'}}">{{reveal ? word.en : '••••••'}}</view>
            <text class="text-btn" bindtap="onToggleAnswer">{{reveal ? '收起答案' : '家长查看当前词'}}</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{isAuto && phase === 'finished'}}">
        <view class="auto-panel">
          <text class="auto-eyebrow">PLAYBACK DONE</text>
          <text class="auto-title">全部 {{total}} 个词播完了</text>
          <text class="auto-desc">现在对照孩子写在纸上的答案，逐词标记“写对了”或“需要练习”。</text>
          <button class="btn btn-block" bindtap="onStartGrade">开始批改</button>
          <text class="helper">“开始批改”是明确的过渡按钮（原型假设，待确认）。</text>
        </view>
      </block>

      <block wx:else>
        <view class="session-card">
          <view class="word-position">
            <text>第 {{index + 1}} 个 / 共 {{total}} 个</text>
            <text class="tag gray">{{isAuto ? '自动听写 · 集中批改' : languageLabel}}</text>
          </view>

          <button class="play-large" bindtap="onPlay">♪</button>
          <text class="audio-state">{{audioStatus}}</text>

          <view class="session-word {{reveal ? '' : 'hide'}}">{{reveal ? word.en : '••••••'}}</view>
          <view class="session-meta" wx:if="{{reveal}}">
            <text class="meaning">{{word.zh}}</text>
            <text class="ipa">{{word.ipa}}</text>
          </view>

          <view class="answer-toggle" bindtap="onToggleAnswer">
            <text>{{reveal ? '◎ 收起答案' : '◎ 家长查看答案'}}</text>
          </view>

          <view class="mark-actions">
            <view
              class="mark-btn correct {{currentState === 'correct' ? 'chosen' : ''}}"
              data-result="correct"
              bindtap="onMark"
            >
              <text class="mark-icon">✓</text>
              <text>写对了</text>
            </view>
            <view
              class="mark-btn wrong {{currentState === 'wrong' ? 'chosen' : ''}}"
              data-result="wrong"
              bindtap="onMark"
            >
              <text class="mark-icon">✕</text>
              <text>需要练习</text>
            </view>
          </view>

          <text class="undo" wx:if="{{currentState}}" bindtap="onClearMark">撤销此词标记</text>
        </view>

        <view class="session-controls">
          <button class="btn btn-sm btn-ghost" disabled="{{index === 0}}" bindtap="onPrev">‹ 上一个</button>
          <text class="inline-helper">标记后自动进入下一词</text>
          <button class="btn btn-sm btn-secondary" bindtap="onNext">{{isLast ? '完成批改' : '下一个 ›'}}</button>
        </view>
      </block>
    </view>

    <view class="side">
      <view class="card">
        <view class="card-pad">
          <view class="card-title-row">
            <text class="card-title">批改进度</text>
            <text class="small">{{marked}}/{{total}}</text>
          </view>

          <view class="word-grid">
            <view
              wx:for="{{results}}"
              wx:for-index="gi"
              wx:key="no"
              class="grid-cell {{item.state}} {{item.current ? 'current' : ''}}"
              data-index="{{gi}}"
              bindtap="onGridTap"
            >{{item.no}}</view>
          </view>

          <view class="legend">
            <text class="lg ok">正确</text>
            <text class="lg bad">错误</text>
            <text class="lg">未批改</text>
          </view>

          <view class="mini-stats">
            <text>正确 <text class="num">{{correct}}</text></text>
            <text>错误 <text class="num">{{wrong}}</text></text>
          </view>

          <button class="btn btn-block" bindtap="onFinishTap">完成批改并保存</button>
          <text class="helper">未批改的词不会算对，也不会被移出错词库。</text>
        </view>
      </view>

      <view class="audio-note">
        <text>{{audioDemo ? '当前为演示占位：没有真实语音，按文本长度模拟播报时长。' : '使用设备音频播放。'}}</text>
        <text>若设备没有可用语音，可由家长查看答案后朗读；本原型不做语音评分。</text>
      </view>
    </view>
  </view>
</view>

<app-modal
  visible="{{modal}}"
  title="{{modalTitle}}"
  desc="{{modalDesc}}"
  actions="{{modalActions}}"
  bind:action="onModalAction"
/>
