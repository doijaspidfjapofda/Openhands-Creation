.main-card {
  overflow: hidden;
}

.auto-panel {
  padding: 26px 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 380px;
  justify-content: center;
}

.auto-eyebrow {
  font-size: 10px;
  letter-spacing: 2px;
  color: #8a9a8f;
  margin-bottom: 8px;
}

.auto-title {
  font-size: 19px;
  font-weight: 650;
  margin-bottom: 8px;
}

.auto-desc {
  font-size: 12px;
  color: #78867f;
  line-height: 1.8;
  max-width: 420px;
  margin-bottom: 18px;
}

.auto-position {
  font-size: 11px;
  letter-spacing: 1px;
  color: #8d9a90;
  margin-bottom: 14px;
}

.interval {
  width: 100%;
  max-width: 380px;
  text-align: left;
  margin-bottom: 18px;
}

.interval-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.interval-value {
  font-size: 12px;
  color: #235f4d;
  font-weight: 600;
}

.pulse {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: #eaf3ed;
  color: #235f4d;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0 14px;
  border: 8px solid #f7faf5;
  animation: breathe 2.4s ease-in-out infinite;
}

.pulse.paused {
  animation: none;
  background: #f2f5ef;
  color: #7d8b81;
}

.pulse-icon {
  font-size: 24px;
  letter-spacing: 2px;
}

@keyframes breathe {
  0% {
    box-shadow: 0 0 0 0 rgba(118, 159, 120, 0.25);
  }
  70% {
    box-shadow: 0 0 0 16px rgba(118, 159, 120, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(118, 159, 120, 0);
  }
}

.audio-state {
  display: block;
  color: #829583;
  font-size: 11px;
  min-height: 18px;
  line-height: 1.7;
}

.wait {
  display: block;
  font-size: 11px;
  color: #a76b32;
  margin-top: 4px;
}

.play-controls {
  display: flex;
  gap: 8px;
  margin: 16px 0 4px;
  flex-wrap: wrap;
  justify-content: center;
}

.peek {
  margin-top: 18px;
  width: 100%;
  max-width: 380px;
  border-top: 1px dashed #e4eae4;
  padding-top: 14px;
}

.peek-word {
  font-family: Georgia, "Songti SC", serif;
  font-size: 24px;
  font-weight: 600;
  min-height: 34px;
}

.peek-word.hide {
  color: #bcc6bd;
  letter-spacing: 6px;
  font-size: 20px;
}

.peek-meta {
  margin-top: 2px;
}

.session-card {
  padding: 24px 18px 22px;
  text-align: center;
  min-height: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.word-position {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #8d9a90;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}

.play-large {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  background: #eaf3ed;
  color: #235f4d;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 7px solid #f7faf5;
  font-size: 28px;
  margin: 4px 0 10px;
}

.session-word {
  font-family: Georgia, "Songti SC", serif;
  font-size: 32px;
  font-weight: 600;
  min-height: 46px;
  margin: 8px 0 4px;
  word-break: break-word;
}

.session-word.hide {
  font-size: 22px;
  color: #bcc6bd;
  letter-spacing: 7px;
}

.session-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.answer-toggle {
  font-size: 11px;
  color: #89998b;
  padding: 10px;
  margin-bottom: 6px;
}

.mark-actions {
  display: flex;
  gap: 10px;
  width: 100%;
  max-width: 380px;
  margin-top: 6px;
}

.mark-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid #e4eae4;
  border-radius: 12px;
  padding: 13px 8px;
  font-size: 13px;
  background: #fff;
}

.mark-icon {
  font-size: 13px;
}

.mark-btn.correct {
  color: #3a7a5d;
}

.mark-btn.wrong {
  color: #b47159;
}

.mark-btn.correct.chosen {
  background: #edf5ec;
  border-color: #75a47d;
}

.mark-btn.wrong.chosen {
  background: #fff1ec;
  border-color: #d5a18d;
}

.undo {
  display: inline-block;
  font-size: 11px;
  color: #8d998c;
  margin-top: 12px;
  padding: 4px;
}

.session-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-top: 1px solid #e4eae4;
  gap: 8px;
}

.inline-helper {
  font-size: 9px;
  color: #a1aba0;
  text-align: center;
  flex: 1;
}

.word-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 7px;
  margin: 6px 0 12px;
}

.grid-cell {
  height: 38px;
  border-radius: 8px;
  background: #f2f5ef;
  color: #81907d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  border: 1px solid transparent;
}

.grid-cell.correct {
  background: #e8f3e7;
  color: #3f7952;
}

.grid-cell.wrong {
  background: #fbece6;
  color: #b46e51;
}

.grid-cell.current {
  border: 2px solid #235f4d;
}

.legend {
  display: flex;
  gap: 12px;
  font-size: 10px;
  color: #8c998e;
  margin-bottom: 10px;
}

.lg::before {
  content: '';
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 2px;
  background: #eef2e8;
  margin-right: 4px;
}

.lg.ok::before {
  background: #9bc49e;
}

.lg.bad::before {
  background: #dfad96;
}

.mini-stats {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #8b978b;
  margin: 8px 0 12px;
}

.mini-stats .num {
  font-size: 14px;
  font-weight: 600;
}

.audio-note {
  font-size: 10px;
  color: #8d998c;
  line-height: 1.8;
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

@media (min-width: 700px) {
  .session-card {
    padding: 28px;
    min-height: 400px;
  }

  .session-word {
    font-size: 36px;
  }

  .word-grid {
    grid-template-columns: repeat(5, 1fr);
  }
}

@media (max-width: 360px) {
  .word-grid {
    grid-template-columns: repeat(5, 1fr);
  }

  .inline-helper {
    display: none;
  }
}
