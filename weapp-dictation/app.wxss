page {
  background: #f7f8f5;
  color: #243b34;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
picker,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: none;
  border-radius: 0;
  color: inherit;
  font-size: inherit;
  text-align: inherit;
}

button::after {
  border: none;
}

.page {
  max-width: 760px;
  margin: 0 auto;
  padding: 18px 16px 108px;
}

.page-head {
  margin-bottom: 18px;
}

.eyebrow {
  display: block;
  font-size: 10px;
  letter-spacing: 1.8px;
  color: #8a9a8f;
  margin-bottom: 6px;
}

.h1 {
  display: block;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.3;
  margin-bottom: 6px;
}

.desc {
  display: block;
  font-size: 12px;
  color: #78867f;
  line-height: 1.8;
}

.card {
  background: #fff;
  border: 1px solid #e4eae4;
  border-radius: 16px;
  box-shadow: 0 8px 28px rgba(36, 73, 55, 0.02);
  overflow: hidden;
}

.card-pad {
  padding: 18px;
}

.card-title {
  display: block;
  font-size: 15px;
  font-weight: 650;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.card-title-row .small {
  font-size: 11px;
  color: #78867f;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: 6px;
  background: #eaf3ed;
  color: #235f4d;
  font-size: 10px;
  line-height: 1.6;
  white-space: nowrap;
}

.tag.amber {
  background: #fff5e8;
  color: #a76b32;
}

.tag.gray {
  background: #f1f4f1;
  color: #78857d;
}

.tag.red {
  background: #fff0ed;
  color: #b75d4f;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 46px;
  padding: 0 18px;
  border-radius: 12px;
  background: #235f4d;
  color: #fff;
  font-size: 14px;
  font-weight: 550;
  border: 1px solid #235f4d;
}

.btn-secondary {
  background: #fff;
  color: #235f4d;
  border-color: #cfded2;
}

.btn-soft {
  background: #eaf3ed;
  color: #235f4d;
  border-color: #eaf3ed;
}

.btn-ghost {
  background: transparent;
  color: #718177;
  border-color: transparent;
}

.btn-danger {
  background: #b75d4f;
  border-color: #b75d4f;
}

.btn-sm {
  height: 36px;
  font-size: 12px;
  padding: 0 13px;
  border-radius: 10px;
}

.btn-block {
  width: 100%;
}

.btn[disabled] {
  opacity: 0.45;
}

.text-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: #235f4d;
  padding: 4px 0;
}

.field-label {
  display: block;
  font-size: 12px;
  font-weight: 550;
  margin-bottom: 8px;
  color: #3d5348;
}

.helper {
  display: block;
  font-size: 10px;
  color: #96a096;
  line-height: 1.8;
  margin-top: 8px;
}

.notice {
  padding: 12px 14px;
  border-radius: 10px;
  background: #f2f6ed;
  color: #73846a;
  line-height: 1.8;
  font-size: 11px;
}

.divider {
  height: 1px;
  background: #e4eae4;
  margin: 16px 0;
}

.metrics {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.metric {
  flex: 1;
  border: 1px solid #e4eae4;
  border-radius: 14px;
  background: #fff;
  padding: 14px;
  min-width: 0;
}

.metric-label {
  display: block;
  font-size: 10px;
  color: #88978c;
}

.metric .num {
  display: block;
  font-size: 26px;
  font-weight: 600;
  letter-spacing: -1px;
  margin: 4px 0 2px;
  line-height: 1.2;
}

.metric .sub {
  display: block;
  font-size: 9px;
  color: #9ea89f;
  line-height: 1.5;
}

.metric.green {
  background: #eef5eb;
  border-color: #dfe8d8;
}

.metric.amber {
  background: #fff9ef;
  border-color: #f0e6d6;
}

.progress {
  height: 5px;
  background: #edf2e9;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #769f78;
  border-radius: 4px;
  transition: width 0.2s;
}

.word-name {
  display: inline-block;
  font-size: 17px;
  font-weight: 650;
  letter-spacing: 0.1px;
  font-family: Georgia, "Songti SC", serif;
  word-break: break-word;
}

.ipa {
  display: block;
  font-size: 10px;
  color: #9ba69e;
  margin-top: 2px;
  font-family: Arial, sans-serif;
}

.meaning {
  display: block;
  font-size: 12px;
  color: #64766b;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #eef2ec;
}

.row:last-child {
  border-bottom: none;
}

.grow {
  flex: 1;
  min-width: 0;
}

.check {
  width: 22px;
  height: 22px;
  border-radius: 7px;
  border: 1px solid #d5dfd1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
  flex: none;
  background: #fff;
}

.check.on {
  background: #235f4d;
  border-color: #235f4d;
}

.empty {
  padding: 40px 20px;
  text-align: center;
  color: #89968c;
}

.empty .mark {
  display: block;
  font-size: 30px;
  color: #a8b9a2;
  margin-bottom: 6px;
}

.empty .title {
  display: block;
  font-size: 16px;
  color: #50694e;
  font-weight: 650;
  margin-bottom: 8px;
}

.empty .desc {
  font-size: 12px;
  line-height: 1.8;
  max-width: 320px;
  margin: 0 auto 16px;
}

.split {
  display: block;
}

.split .side {
  margin-top: 16px;
}

.section-gap {
  margin-top: 16px;
}

.muted {
  color: #8a958b;
}

.mini-label {
  font-size: 10px;
  color: #a2aba5;
}

.crumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #88948d;
  margin-bottom: 14px;
}

.crumbs .back {
  color: #235f4d;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.crumbs .spacer {
  flex: 1;
}

@media (min-width: 700px) {
  .page {
    max-width: 960px;
    padding: 24px 32px 120px;
  }

  .h1 {
    font-size: 27px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 22px;
    align-items: start;
  }

  .split .side {
    margin-top: 0;
    position: sticky;
    top: 96px;
  }

  .card-pad {
    padding: 22px;
  }
}
